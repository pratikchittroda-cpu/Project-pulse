{
  "name": "releasearc-vscode-extension",
  "version": "0.0.0",
  "private": true,
  "displayName": "ReleaseArc",
  "description": "Privacy-aware ReleaseArc delivery workspace companion for VS Code and Cursor.",
  "publisher": "releasearc",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:releasearc.openWorkspace",
    "onCommand:releasearc.linkWorkspace",
    "onCommand:releasearc.setTelemetryConsent"
  ],
  "contributes": {
    "commands": [
      {
        "command": "releasearc.openWorkspace",
        "title": "ReleaseArc: Open Workspace",
        "category": "ReleaseArc"
      },
      {
        "command": "releasearc.linkWorkspace",
        "title": "ReleaseArc: Link Workspace",
        "category": "ReleaseArc"
      },
      {
        "command": "releasearc.setTelemetryConsent",
        "title": "ReleaseArc: Manage Activity Consent",
        "category": "ReleaseArc"
      }
    ],
    "configuration": {
      "title": "ReleaseArc",
      "properties": {
        "releasearc.workspaceUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "ReleaseArc web workspace URL."
        },
        "releasearc.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow privacy-aware activity telemetry after authentication and explicit consent."
        }
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "node ../../scripts/workspace-dev.mjs releasearc-vscode-extension",
    "build": "tsc -p tsconfig.json",
    "package": "corepack pnpm run build && corepack pnpm exec vsce package --no-dependencies --out releasearc.vsix",
    "test": "node ../../scripts/check-workspace-package.mjs releasearc-vscode-extension",
    "lint": "node ../../scripts/check-workspace-package.mjs releasearc-vscode-extension lint",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@releasearc/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.2.2",
    "typescript": "5.8.3"
  }
}
