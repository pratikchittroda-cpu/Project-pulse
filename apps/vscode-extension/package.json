{
  "name": "projectpulse-vscode-extension",
  "version": "0.0.0",
  "private": true,
  "displayName": "ProjectPulse",
  "description": "Privacy-aware ProjectPulse workspace companion for VS Code and Cursor.",
  "publisher": "projectpulse",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:projectpulse.openWorkspace",
    "onCommand:projectpulse.linkWorkspace",
    "onCommand:projectpulse.setTelemetryConsent"
  ],
  "contributes": {
    "commands": [
      {
        "command": "projectpulse.openWorkspace",
        "title": "ProjectPulse: Open Workspace",
        "category": "ProjectPulse"
      },
      {
        "command": "projectpulse.linkWorkspace",
        "title": "ProjectPulse: Link Workspace",
        "category": "ProjectPulse"
      },
      {
        "command": "projectpulse.setTelemetryConsent",
        "title": "ProjectPulse: Manage Activity Consent",
        "category": "ProjectPulse"
      }
    ],
    "configuration": {
      "title": "ProjectPulse",
      "properties": {
        "projectpulse.workspaceUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "ProjectPulse web workspace URL."
        },
        "projectpulse.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow privacy-aware activity telemetry after authentication and explicit consent."
        }
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "node ../../scripts/workspace-dev.mjs projectpulse-vscode-extension",
    "build": "tsc -p tsconfig.json",
    "package": "corepack pnpm run build && corepack pnpm exec vsce package --no-dependencies --out projectpulse.vsix",
    "test": "node ../../scripts/check-workspace-package.mjs projectpulse-vscode-extension",
    "lint": "node ../../scripts/check-workspace-package.mjs projectpulse-vscode-extension lint",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@projectpulse/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.2.2",
    "typescript": "5.8.3"
  }
}
