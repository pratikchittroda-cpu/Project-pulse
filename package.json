{
  "name": "releasearc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=10.12.1 <11"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @releasearc/web dev",
    "build": "corepack pnpm run workspace:check && corepack pnpm --recursive run build",
    "docker:build": "docker build --tag releasearc:local .",
    "docker:run": "docker run --rm --publish ${RELEASEARC_PORT:-${PROJECTPULSE_PORT:-8080}}:8080 releasearc:local",
    "supabase:start": "node ./scripts/supabase.mjs start",
    "supabase:stop": "node ./scripts/supabase.mjs stop",
    "supabase:status": "node ./scripts/supabase.mjs status",
    "supabase:reset": "node ./scripts/supabase.mjs reset",
    "supabase:seed": "node ./scripts/supabase.mjs seed",
    "realtime:setup": "corepack pnpm exec supabase status -o env > .realtime-status.env && node ./scripts/realtime-test-setup.mjs",
    "test": "corepack pnpm run quality",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:db": "node ./scripts/test-database.mjs",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:realtime": "vitest run --config vitest.api.config.ts tests/realtime.integration.ts",
    "test:workspaces": "corepack pnpm --recursive run test",
    "quality": "corepack pnpm run workspace:check && corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run format:check && corepack pnpm run build && corepack pnpm run test:unit && corepack pnpm run test:workspaces",
    "lint": "corepack pnpm run workspace:check && eslint . && corepack pnpm --recursive run lint",
    "format": "prettier --write \"package.json\" \"tsconfig.base.json\" \"eslint.config.mjs\" \"vitest*.config.ts\" \".prettierrc.json\" \"apps/**/*.{css,html,json,mjs,ts,tsx}\" \"packages/**/*.{css,json,mjs,ts,tsx}\" \"scripts/**/*.mjs\" \"supabase/functions/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"package.json\" \"tsconfig.base.json\" \"eslint.config.mjs\" \"vitest*.config.ts\" \".prettierrc.json\" \"apps/**/*.{css,html,json,mjs,ts,tsx}\" \"packages/**/*.{css,json,mjs,ts,tsx}\" \"scripts/**/*.mjs\" \"supabase/functions/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "corepack pnpm run workspace:check && corepack pnpm --recursive run typecheck",
    "bootstrap:test": "node ./scripts/check-bootstrap.mjs",
    "workspace:check": "node ./scripts/check-workspaces.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@testing-library/react": "16.1.0",
    "eslint": "9.20.1",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "lucide-react": "0.468.0",
    "prettier": "3.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2",
    "supabase": "2.121.0",
    "typescript-eslint": "8.46.3",
    "vitest": "3.2.4"
  }
}
