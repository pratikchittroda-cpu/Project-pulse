# Public browser configuration. Use local Supabase values for development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server and integration configuration are intentionally placeholders until
# the Supabase and GitHub tasks add their runtime consumers.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-github-app-private-key
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
